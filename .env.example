# Plaid API keys: https://dashboard.plaid.com/developers/keys
# Sandbox and production use different secrets. Never commit this file's twin (.env).
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
# PLAID_SECRET=            # fallback used when the env-specific one above is empty
# sandbox | production  (selects the API host, the secret, the SQLite file data/plaid-<env>.db and the Keychain namespace)
PLAID_ENV=sandbox


# Optional
# LINK_TIMEOUT_SECONDS=1800   # how long `npm run link` waits for you to finish in the browser
# TRANSACTION_DAYS=365   # history requested at link time (max 730; fixed per item once linked)

# ---- Hosted mode only (src/http-server.ts on Fly.io); set these as `fly secrets`, not here ----
# TOKEN_STORE=db
# TOKEN_ENCRYPTION_KEY=   # openssl rand -base64 32 ; also needed locally for `cli export-items`
# MCP_PASSPHRASE=         # what you type on the OAuth login page
# PUBLIC_URL=https://<app>.fly.dev
# APP_NAME=Finance MCP   # shown on Plaid's Link screen and the login page
# ALLOWED_REDIRECTS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,localhost,127.0.0.1,[::1]
#                         # exact https callback URLs, plus bare loopback hosts for Claude Code
# TRUST_PROXY=1           # proxy hops in front of the app; defaults to 1 on Fly and 0 elsewhere
# HOSTED_UNLINK=false     # expose the destructive unlink tool over MCP; otherwise use the CLI
# DATA_DIR=/data
